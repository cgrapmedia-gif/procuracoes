{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node", "jest", "multer"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@proc/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
