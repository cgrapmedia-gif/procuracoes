# ─── Copiar para apps/api/.env e preencher. NUNCA fazer commit do .env ───────────────────────
NODE_ENV=development
PORT=3001

# Base de dados Neon (consola Neon → Connect). Dois URLs do MESMO branch, SEMPRE entre aspas (contêm &):
#  - DATABASE_URL: ligação com pooler (host contém "-pooler") → usada pela aplicação
#  - DATABASE_URL_DIRECT: ligação directa (sem "-pooler") → migrações, bootstrap e seed
DATABASE_URL="postgresql://neondb_owner:SENHA@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_DIRECT="postgresql://neondb_owner:SENHA@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=15000
# Testes automáticos: branch próprio no Neon (é APAGADO a cada execução). Nunca o de produção.
# TEST_DATABASE_URL="postgresql://neondb_owner:SENHA@ep-yyyy.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Segredos (gerar com os comandos indicados; guardar num cofre)
JWT_SECRET=            # openssl rand -base64 48
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
DATA_ENC_KEY=          # openssl rand -base64 32   ← perdê-la = perder os dados pessoais cifrados
DATA_BIDX_KEY=         # openssl rand -base64 48

# Origem do frontend (só relevante se a API for chamada directamente de outro domínio)
CORS_ORIGIN=http://localhost:3000

# Armazenamento de documentos: "local" em desenvolvimento, "s3" em produção
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=           # AWS: vazio · MinIO: http://localhost:9000 · R2: https://<conta>.r2.cloudflarestorage.com
S3_REGION=eu-west-1    # R2: auto
S3_BUCKET=procuracoes
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SSE=AES256          # R2: none
S3_CONDITIONAL_WRITES=true

# Chromium para o PDF (a imagem Docker já o inclui em /usr/bin/chromium)
CHROMIUM_PATH=
SEGREGACAO_FUNCOES=true
# Proxies à frente da API. Caddy → Next.js → API: 1 (o Next.js passa o X-Forwarded-For do Caddy tal como está)
TRUST_PROXY_HOPS=1

# Apenas para `npm run db:bootstrap` (primeira instalação em produção)
BOOT_ORG_CODE=CGA-PORTO
BOOT_ORG_NAME="Consulado Geral no Porto"
BOOT_ORG_FULLNAME="Consulado Geral da República de Angola no Porto"
BOOT_ORG_ADDRESS=
BOOT_ORG_CITY=Porto
BOOT_ADMIN_EMAIL=
BOOT_ADMIN_NAME=
BOOT_ADMIN_PASSWORD=
BOOT_OFFICER_NAME=
BOOT_OFFICER_TITLE=Vice-Cônsul
BOOT_NUM_PREFIX=PROC
BOOT_NUM_SERIE=
